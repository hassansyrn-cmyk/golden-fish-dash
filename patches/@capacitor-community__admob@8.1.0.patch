--- a/android/src/main/java/com/getcapacitor/community/admob/models/AdMobPluginError.kt
+++ b/android/src/main/java/com/getcapacitor/community/admob/models/AdMobPluginError.kt
@@ -2,14 +2,61 @@ package com.getcapacitor.community.admob.models
 
 import com.getcapacitor.JSObject
 import com.google.android.gms.ads.AdError
+import com.google.android.gms.ads.LoadAdError
+import org.json.JSONArray
 
-data class AdMobPluginError(val code: Int, val message: String) : JSObject() {
+private fun safeResponseInfo(adError: AdError): JSObject? {
+    val info = (adError as? LoadAdError)?.responseInfo ?: return null
+    val result = JSObject()
+
+    info.responseId?.takeIf { it.isNotBlank() }?.let { result.put("responseId", it) }
+    info.mediationAdapterClassName?.takeIf { it.isNotBlank() }?.let {
+        result.put("mediationAdapterClassName", it)
+    }
+
+    val adapterResponses = JSONArray()
+    info.adapterResponses.take(8).forEach { adapterResponse ->
+        val response = JSObject()
+        adapterResponse.adapterClassName?.takeIf { it.isNotBlank() }?.let {
+            response.put("adapterClassName", it)
+        }
+        response.put("latencyMillis", adapterResponse.latencyMillis)
+        adapterResponse.description?.takeIf { it.isNotBlank() }?.let {
+            response.put("description", it.take(500))
+        }
+        adapterResponses.put(response)
+    }
+    if (adapterResponses.length() > 0) result.put("adapterResponses", adapterResponses)
+
+    return result.takeIf { it.length() > 0 }
+}
+
+data class AdMobPluginError(
+    val code: Int,
+    val message: String,
+    val domain: String?,
+    val adUnitId: String?,
+    val responseInfo: JSObject?,
+) : JSObject() {
     override fun put(key: String, value: Int): JSObject {
         throw Exception("Do not put elements directly here use the constructor")
     }
+
     init {
         super.put("code", this.code)
         super.put("message", this.message)
+        if (this.domain != null) super.put("domain", this.domain)
+        if (this.adUnitId != null) super.put("adUnitId", this.adUnitId)
+        if (this.responseInfo != null) super.put("responseInfo", this.responseInfo)
     }
-    constructor(adError: AdError): this(adError.code, adError.message)
+
+    constructor(code: Int, message: String) : this(code, message, null, null, null)
+
+    constructor(adError: AdError, adUnitId: String? = null) : this(
+        adError.code,
+        adError.message,
+        adError.domain,
+        adUnitId,
+        safeResponseInfo(adError),
+    )
 }
